<?xml version="1.0" encoding="UTF-8"?>
<!--
  MR3 same-host diagnostic transport for Fast DDS 2.6.x.
  Use ROS_LOCALHOST_ONLY=0: Humble rmw_fastrtps otherwise appends an SHM
  descriptor after loading this default participant profile.
  Transport rates, buffers and discovery limits retain their defaults.
  Only the 18 exact Nav2 change_state response writers below receive a bounded
  5-second DDS matching/write wait. No default, service fallback or reader profile.
  Official syntax: https://fast-dds.docs.eprosima.com/en/v2.6.11/fastdds/transport/udp/udp.html
  Whitelist: https://fast-dds.docs.eprosima.com/en/v2.6.11/fastdds/transport/whitelist.html
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>mr3_loopback_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="mr3_loopback_udp_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>mr3_loopback_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
  <publisher profile_name="rr/tb1/controller_server/change_stateReply">
    <qos>
      <reliability>
        <kind>RELIABLE</kind>
        <max_blocking_time>
          <sec>5</sec>
          <nanosec>0</nanosec>
        </max_blocking_time>
      </reliability>
    </qos>
  </publisher>
