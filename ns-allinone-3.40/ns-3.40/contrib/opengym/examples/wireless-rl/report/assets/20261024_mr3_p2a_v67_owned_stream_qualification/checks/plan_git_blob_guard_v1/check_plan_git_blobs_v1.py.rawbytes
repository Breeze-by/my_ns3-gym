#!/usr/bin/env python3
"""Read-only plan/current/INDEX-or-exact-HEAD byte check; never stage files."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import tempfile


def require(value, message):
    if not value:
        raise ValueError(message)


def decode(raw):
    def unique(pairs):
        result = {}
        for key, value in pairs:
            require(key not in result, 'duplicate JSON key: ' + key)
            result[key] = value
        return result
    return json.loads(raw, object_pairs_hook=unique,
                      parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)))


def git(root, *argv):
    return subprocess.check_output(['git', '-C', str(root), *argv], stderr=subprocess.PIPE)


def relative(root, path):
    value = os.path.relpath(path, root)
    require(value != '.' and not Path(value).is_absolute()
            and '..' not in Path(value).parts and '.git' not in Path(value).parts,
            'source is outside repository or inside .git: ' + str(path))
    return Path(value).as_posix()


def current(root, name):
    path = root / name
    for parent in [path, *path.parents]:
        require(not stat.S_ISLNK(parent.lstat().st_mode), 'symlink is not a regular source: ' + str(parent))
        if parent == root:
            break
    before = path.stat()
    require(stat.S_ISREG(before.st_mode), 'not a regular source: ' + name)
    digest = hashlib.sha256()
    with path.open('rb') as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b''):
            digest.update(block)
    after = path.stat()
    require(all(getattr(before, key) == getattr(after, key) for key in
                ('st_dev', 'st_ino', 'st_size', 'st_mtime_ns', 'st_ctime_ns')),
            'source changed while hashing: ' + name)
    return {'sha256': digest.hexdigest(), 'bytes': after.st_size}


def entries(root, revision):
    raw = git(root, 'ls-files', '--stage', '-z') if revision == 'INDEX' else git(
        root, 'ls-tree', '-r', '-z', '--full-tree', revision)
    result = {}
    for item in raw.split(b'\0'):
        if not item:
            continue
        header, name = item.split(b'\t', 1)
        fields = header.decode('ascii').split()
        mode, oid, phase = fields if revision == 'INDEX' else (fields[0], fields[2], fields[1])
        result.setdefault(os.fsdecode(name), []).append((mode, oid, phase))
    return result


def blob_hashes(root, identifiers):
    result = {}
    with tempfile.TemporaryFile() as errors:
        child = subprocess.Popen(['git', '-C', str(root), 'cat-file', '--batch'],
                                 stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=errors)
        try:
            for oid in sorted(set(identifiers)):
                child.stdin.write((oid + '\n').encode('ascii')); child.stdin.flush()
                header = child.stdout.readline().decode('ascii').split()
                require(len(header) == 3 and header[0] == oid and header[1] == 'blob',
                        'cat-file did not return exact regular blob: ' + oid)
                remaining = int(header[2]); size = remaining; digest = hashlib.sha256()
                while remaining:
                    block = child.stdout.read(min(1024 * 1024, remaining))
                    require(block, 'truncated Git blob: ' + oid)
                    digest.update(block); remaining -= len(block)
                require(child.stdout.read(1) == b'\n', 'missing Git batch separator')
                result[oid] = {'sha256': digest.hexdigest(), 'bytes': size}
        finally:
            try:
                child.stdin.close()
            finally:
                child.stdout.close()
                rc = child.wait()
        require(rc == 0, 'git cat-file failed: ' + str(rc))
    return result


def check(plan_path, revision):
    root = Path(git(plan_path.parent, 'rev-parse', '--show-toplevel').decode().strip()).resolve(strict=True)
    plan_name = relative(root, plan_path)
    require(plan_path == root / plan_name, 'PLAN must use its canonical lexical repository path')
    head = git(root, 'rev-parse', 'HEAD').decode().strip()
    require(revision == 'INDEX' or (re.fullmatch('[0-9a-f]{40}', revision) and revision == head),
            '--revision must be INDEX or the exact current 40-hex HEAD')
    plan_proof = current(root, plan_name)
    plan_raw = plan_path.read_bytes()
    require(hashlib.sha256(plan_raw).hexdigest() == plan_proof['sha256'], 'PLAN changed before parsing')
    plan = decode(plan_raw)
    bindings = plan['source_bindings']
    require(type(bindings) is dict and bindings, 'nonempty source_bindings required')
    expected, roles = {}, {}
    def add(name, digest, role):
        require(type(name) is str and name and not Path(name).is_absolute()
                and name == Path(name).as_posix() and '..' not in Path(name).parts
                and '.git' not in Path(name).parts, 'unsafe repository source path: ' + str(name))
        require(type(digest) is str and re.fullmatch('[0-9a-f]{64}', digest), 'invalid SHA256 for ' + name)
        require(expected.setdefault(name, digest) == digest, 'conflicting source SHA256: ' + name)
        roles.setdefault(name, []).append(role)
    for name, digest in bindings.items():
        add(name, digest, 'plan.source_bindings')
    add(plan_name, plan_proof['sha256'], 'PLAN')
    for path in sorted(plan_path.parent.glob('*.py')):
        name = relative(root, path)
        add(name, current(root, name)['sha256'], 'current_activity_top_py')
    table = entries(root, revision)
    rows, errors, oids = [], [], []
    for name, digest in sorted(expected.items()):
        row = {'path': name, 'roles': roles[name], 'expected_sha256': digest}
        try:
            row['current'] = current(root, name)
            require(row['current']['sha256'] == digest, 'current SHA256 differs from expected')
        except (OSError, ValueError) as error:
            errors.append({'path': name, 'kind': 'current_rejected', 'reason': str(error)})
        selected = table.get(name, [])
        if not selected:
            errors.append({'path': name, 'kind': 'git_path_missing', 'reason': 'absent from ' + revision})
        elif len(selected) != 1 or selected[0][0] not in ('100644', '100755') or selected[0][2] != ('0' if revision == 'INDEX' else 'blob'):
            errors.append({'path': name, 'kind': 'git_nonregular_or_unmerged', 'entries': selected})
        else:
            mode, oid, _ = selected[0]
            row.update(git_mode=mode, git_oid=oid); oids.append(oid)
        rows.append(row)
    blobs = blob_hashes(root, oids)
    for row in rows:
        if 'git_oid' in row:
            row['git_blob'] = blobs[row['git_oid']]
            if row['git_blob']['sha256'] != row['expected_sha256']:
                errors.append({'path': row['path'], 'kind': 'git_blob_sha256_differs',
                               'actual': row['git_blob']['sha256'], 'expected': row['expected_sha256']})
        try:
            require(current(root, row['path']) == row.get('current'), 'current source changed during checker')
        except (OSError, ValueError) as error:
            errors.append({'path': row['path'], 'kind': 'post_current_rejected', 'reason': str(error)})
    after_table = entries(root, revision)
    require({name: table.get(name) for name in expected} ==
            {name: after_table.get(name) for name in expected}, 'selected Git entries changed during checker')
    require(git(root, 'rev-parse', 'HEAD').decode().strip() == head, 'HEAD changed during checker')
    return {'schema': 'mr3-plan-current-git-blob-precommit-check-v1', 'passed': not errors,
            'plan': str(plan_path), 'plan_sha256': plan_proof['sha256'], 'repository': str(root),
            'revision': revision, 'head_observed': head, 'expected_path_count': len(rows),
            'plan_source_binding_count': len(bindings), 'checked_regular_git_blob_count': len(oids),
            'unique_git_blob_count': len(blobs), 'errors': errors, 'paths': rows,
            'native_libraries_included_via_library_bindings': False,
            'canonical_mutations': 0, 'index_mutations': 0, 'scientific_credit': False}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--plan', required=True, type=Path)
    parser.add_argument('--revision', required=True)
    parser.add_argument('--output', type=Path)
    args = parser.parse_args()
    result = check(args.plan.absolute(), args.revision)
    if args.output is not None:
        with args.output.open('x') as stream:
            json.dump(result, stream, indent=2, allow_nan=False); stream.write('\n')
    print(json.dumps({key: result[key] for key in ('passed', 'revision', 'expected_path_count',
          'checked_regular_git_blob_count', 'errors')}, allow_nan=False))
    return 0 if result['passed'] else 1


if __name__ == '__main__':
    raise SystemExit(main())
