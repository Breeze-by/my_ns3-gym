"""Operational CPU wrapper for the one canonical A67 plan preparation."""
from pathlib import Path
import json
import os
import subprocess

ROOT=Path('/home/zhuyulab/ns3-workspace')
W=ROOT/'ns-allinone-3.40/ns-3.40/contrib/opengym/examples/wireless-rl'
A=W/'report/assets/20261024_mr3_p2a_v67_owned_stream_qualification'
OLD=A.parent/'20261024_mr3_p2a_v65_owned_stream_qualification'
BUILD=A.parent/'20261024_mr3_p2a_v66_owned_stream_qualification'
assert Path.cwd()==W
wait=json.loads((A/'checks/admission_cpu_v1/actual_wait.json').read_text())
assert wait['passed'] is True and wait['source_before']==wait['source_after']
sources={Path(row['path']) for row in wait['source_before']}
sources.update(Path(row['path']) for row in json.loads((BUILD/'checks/native_build_v1/build_actual_wait/actual_wait.json').read_text())['source_before'])
sources.update((Path(__file__),BUILD/'native_build_bridge_v1.json',BUILD/'checks/native_build_v1/build_manifest_v1.json',OLD/'prepare_plan_v1.py',OLD/'readiness_v1.py'))
argv=['/usr/bin/python3','-B','-m','mr3_learning.reach_execution','--scope','cpu','--output',str(A/'checks/prepare_cpu_v1')]
for path in sorted(sources):argv+=['--source',str(path)]
argv+=['--','/usr/bin/python3','-B','-m','report.assets.20261024_mr3_p2a_v67_owned_stream_qualification.prepare_plan_v1','--engineering-resource-sha256','b426704d2a2924ab6629558994b89f60823ab7ddf2b6dc7e92a17d8b34fbd13a']
env=dict(os.environ,PYTHONNOUSERSITE='1',PYTHONDONTWRITEBYTECODE='1',CUDA_VISIBLE_DEVICES='')
env.pop('PYTHONPATH',None);env.pop('PYTHONHOME',None)
raise SystemExit(subprocess.call(argv,cwd=W,env=env))
