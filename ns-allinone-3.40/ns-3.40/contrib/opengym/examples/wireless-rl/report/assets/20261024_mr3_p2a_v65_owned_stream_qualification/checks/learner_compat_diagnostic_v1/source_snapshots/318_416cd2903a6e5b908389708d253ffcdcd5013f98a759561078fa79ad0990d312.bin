"""Exact declared Conda test set minus two acknowledged collection blockers."""
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys

ROOT=Path('/home/zhuyulab/ns3-workspace')
W=ROOT/'ns-allinone-3.40/ns-3.40/contrib/opengym/examples/wireless-rl'
A=W/'report/assets/20261024_mr3_p2a_v65_owned_stream_qualification'
SPEC=A/'fresh_cpu_spec_v2.json'
OUT=A/'checks/learner_compat_diagnostic_v1'
PY='/home/zhuyulab/miniconda3/envs/ns3gym/bin/python'
EXCLUDE={'test_mr3_probe_lifecycle_fixture.py','test_reach_outward_cancel_v2_producer.py'}


def identity():
    fields=Path('/proc/self/stat').read_text().rsplit(')',1)[1].split()
    return dict(pid=os.getpid(),parent=int(fields[1]),group=int(fields[2]),session=int(fields[3]),start_ticks=int(fields[19]))


def main():
    OUT.mkdir(parents=True,exist_ok=False);snapshots=OUT/'source_snapshots';snapshots.mkdir()
    spec=json.loads(SPEC.read_text());group=next(row for row in spec['groups'] if row['environment']=='ns3gym')
    omitted=[name for name in group['test_files'] if Path(name).name in EXCLUDE]
    if {Path(name).name for name in omitted}!=EXCLUDE:raise ValueError('known collection blockers not exactly present')
    tests=[name for name in group['test_files'] if name not in omitted]
    sources=[ROOT/name for name in spec['source_bindings']]+[SPEC,Path(__file__),Path(PY).resolve()]
    rows=[]
    for ordinal,path in enumerate(sources):
        raw=path.read_bytes();sha=hashlib.sha256(raw).hexdigest()
        if str(path).startswith(str(ROOT)+'/'):
            relative=str(path.relative_to(ROOT));declared=spec['source_bindings'].get(relative)
            if declared is not None and declared!=dict(sha256=sha,bytes=len(raw)):
                raise ValueError('current source differs from fresh v2 declaration: '+relative)
        snapshot=snapshots/f'{ordinal:03d}_{sha}.bin';snapshot.open('xb').write(raw)
        rows.append(dict(path=str(path),bytes=len(raw),sha256=sha,snapshot=str(snapshot)))
    command=[PY,'-B','-m','pytest','-q','-p','no:cacheprovider',*[str(ROOT/name) for name in tests],
             '--junitxml',str(OUT/'junit.xml')]
    (OUT/'source_recovery_v1.json').open('x').write(json.dumps(dict(
        schema='mr3-v65-learner-fixture-compatibility-diagnostic-v1',base_HEAD=subprocess.check_output(
            ['git','rev-parse','HEAD'],cwd=ROOT,text=True).strip(),sources=rows,
        original_spec=str(SPEC),original_spec_sha256=hashlib.sha256(SPEC.read_bytes()).hexdigest(),
        selected_test_files=tests,excluded_known_collection_blockers=omitted,
        actual_test_argv=command,formal_fresh_group_credit=False,scientific_credit=False),indent=2)+'\n')
    (OUT/'runner_identity_v1.json').open('x').write(json.dumps(dict(identity=identity(),actual_argv=sys.argv),indent=2)+'\n')
    argv=[PY,'-B','-m','mr3_learning.reach_execution','--scope','cpu','--output',str(OUT/'actual')]
    for source in sources:argv.extend(['--source',str(source)])
    env=dict(os.environ,PYTHONNOUSERSITE='1',PYTHONDONTWRITEBYTECODE='1')
    env.pop('PYTHONPATH',None);env.pop('PYTHONHOME',None)
    return subprocess.call([*argv,'--',*command],cwd=W,env=env)


if __name__=='__main__':raise SystemExit(main())
