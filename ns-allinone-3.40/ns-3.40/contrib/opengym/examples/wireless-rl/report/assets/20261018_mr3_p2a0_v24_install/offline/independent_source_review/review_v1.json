  "final_source_sha_stat_stable": true,
  "findings": [
    {
      "id": "uninitialized-counter",
      "conclusion": "WorldPrivate iterations is an uninitialized fundamental member before World::Init, because new WorldPrivate is default-initialized and neither its class nor World constructor/Load initializes the counter. Reading it in WorldCreated is invalid; reject that read, not the physical limits.",
      "evidence": [
        {
          "input": "private",
          "path": "/tmp/mr3_p2a0_v24_install_lifecycle_proposal_v1/primary/WorldPrivate.hh",
          "line_1based": 307,
          "anchor": "public: uint64_t iterations;"
        },
        {
          "input": "world",
          "path": "/tmp/mr3_p2a0_v18_driver_diagnostic_proposal_v5/World_11.10.2.cc",
          "line_1based": 113,
          "anchor": ": dataPtr(new WorldPrivate)"
        },
        {
          "input": "world",
          "path": "/tmp/mr3_p2a0_v18_driver_diagnostic_proposal_v5/World_11.10.2.cc",
          "line_1based": 497,
          "anchor": "  this->dataPtr->iterations = 0;\n  this->dataPtr->logPrevIteration = 0;"
        }
      ]
    },
    {
      "id": "Running-not-thread-state",
      "conclusion": "Running returns !stop and ctor sets stop=false. Thus normal preInit Running may be true; its false value is not a legal prerequisite. Record typed actual value only.",
      "evidence": [
        {
          "input": "world",
          "path": "/tmp/mr3_p2a0_v18_driver_diagnostic_proposal_v5/World_11.10.2.cc",
          "line_1based": 564,
          "anchor": "bool World::Running() const"
        },
        {
          "input": "world",
          "path": "/tmp/mr3_p2a0_v18_driver_diagnostic_proposal_v5/World_11.10.2.cc",
          "line_1based": 133,
          "anchor": "  this->dataPtr->stop = false;\n  this->dataPtr->sensorsInitialized = false;"
        }
      ]
    },
    {
      "id": "defined-getters",
      "conclusion": "IsLoaded and SensorsInitialized are explicitly initialized false. SimTime contains a default-constructed Time with sec=nsec=0. Models/GetLinks/GetSensorCount use fully constructed vector containers; no analogous uninitialized scalar count.",
      "time_primary_url": "https://raw.githubusercontent.com/gazebosim/gazebo-classic/gazebo11_11.10.2/gazebo/common/Time.cc",
      "link_primary_url": "https://raw.githubusercontent.com/gazebosim/gazebo-classic/gazebo11_11.10.2/gazebo/physics/Link.cc"
    },
    {
      "id": "before-first-physics-and-sensor",
      "conclusion": "On the declared initial single-world Server startup path, worldCreated runs synchronously inside World::Load, after ODE constructor/Load and entity loading, before Load completes and World::Init. Server first run_once/sensor threads/world threads occur later. Rejecting already-created model sensors preserves the sensor-free installation precondition. This source/event ordering, not Running=false, establishes the intended phase.",
      "evidence": [
        {
          "input": "world",
          "path": "/tmp/mr3_p2a0_v18_driver_diagnostic_proposal_v5/World_11.10.2.cc",
          "line_1based": 414,
          "anchor": "  event::Events::worldCreated(this->Name());"
        },
        {
          "input": "server",
          "path": "/tmp/mr3_p2a0_v22_ray_box_corrector_proposal_v1/primary/Server_11.10.2.cc",
          "line_1based": 554,
          "anchor": "      physics::load_world(world, worldElem);"
        },
        {
          "input": "server",
          "path": "/tmp/mr3_p2a0_v22_ray_box_corrector_proposal_v1/primary/Server_11.10.2.cc",
          "line_1based": 591,
          "anchor": "    physics::init_worlds(nullptr);"
        },
        {
          "input": "server",
          "path": "/tmp/mr3_p2a0_v22_ray_box_corrector_proposal_v1/primary/Server_11.10.2.cc",
          "line_1based": 651,
          "anchor": "  sensors::run_once(true);"
        },
        {
          "input": "server",
          "path": "/tmp/mr3_p2a0_v22_ray_box_corrector_proposal_v1/primary/Server_11.10.2.cc",
          "line_1based": 654,
          "anchor": "  sensors::run_threads();"
        },
        {
          "input": "server",
          "path": "/tmp/mr3_p2a0_v22_ray_box_corrector_proposal_v1/primary/Server_11.10.2.cc",
          "line_1based": 673,
          "anchor": "  physics::run_worlds(iterations);"
        }
      ]
    },
    {
      "id": "system-Init-too-early",
      "conclusion": "SystemPlugin Load/Init runs in gazebo_shared.setup during Server.PreLoad before the world/ODE engine exists. Moving installation blindly to SystemPlugin::Init would lose required native ODE world/table availability.",
      "evidence": [
        {
          "input": "shared",
          "path": "/tmp/mr3_p2a0_v24_install_lifecycle_proposal_v1/primary/gazebo_shared.cc",
          "line_1based": 92,
          "anchor": "    (*iter)->Init();"
        },
        {
          "input": "server",
          "path": "/tmp/mr3_p2a0_v22_ray_box_corrector_proposal_v1/primary/Server_11.10.2.cc",
          "line_1based": 513,
          "anchor": "  return gazebo::setupServer(this->dataPtr->systemPluginsArgc,"
        }
      ]
    },
    {
      "id": "narrow-proposal",
      "conclusion": "Only the created callback body changes from exact b165 to f826. It does not read Iterations, records explicit phase/null/availability/reason, validates initialized actual getters, preserves actual150/.001 native readback, CAS/dSetColliderOverride/lifetime/core math and failures remain source-bound. No physical/braking/task gate was lowered."
    }
  ],
