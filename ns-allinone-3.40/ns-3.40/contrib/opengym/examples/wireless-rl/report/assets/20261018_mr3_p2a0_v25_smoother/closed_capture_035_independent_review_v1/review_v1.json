    "source_excerpt": "359:             for captured in base['owned_current_processes']:\n360:                 argv, identity = captured['argv'], captured['identity']\n361:                 if not argv or Path(argv[0]).name != 'velocity_smoother':\n362:                     continue\n363:                 current = util.proc_identity(identity['pid'], proc_root)\n364:                 if current is None:\n365:                     continue\n366:                 require(pair(current) == pair(identity), 'smoother PID reused')\n367:                 if current['state'] == 'Z':\n368:                     continue\n369:                 chain = util.ancestor_chain(current, worker, inventory, proc_root)\n370:                 if chain is None:\n371:                     continue\n372:                 raw_argv = (proc_root / str(identity['pid']) / 'cmdline').read_bytes()\n373:                 actual_argv = raw_argv.decode().rstrip('\\0').split('\\0')\n374:                 require(actual_argv == argv and argv[0] == executable['path']\n375:                         and (proc_root / str(identity['pid']) / 'exe').resolve(strict=True)\n376:                         == Path(executable['resolved']), 'actual smoother executable/argv differs')\n377:                 executable_stat = (proc_root / str(identity['pid']) / 'exe').stat()\n378:                 require(executable_stat.st_ino == executable['inode']\n379:                         and executable_stat.st_dev == executable['stat'][0]\n380:                         and executable_stat.st_mode & 0o111, 'actual executable inode/device/permission differs')\n381:                 robot = util.namespace(argv)\n382:                 require(robot not in result['processes'], 'duplicate actual smoother namespace')\n383:                 maps_path = proc_root / str(identity['pid']) / 'maps'\n384:                 maps_raw = maps_path.read_bytes()\n385:                 lines = map_lines(maps_raw, core)\n386:                 require(file_proof(binding['installed']['executable'], read) == executable\n387:                         and file_proof(binding['installed']['core'], read) == core, 'ELF identity changed during capture')\n388:                 after = util.proc_identity(identity['pid'], proc_root)\n389:                 if after is None or (pair(after) == pair(identity) and after['state'] == 'Z'):\n390:                     result['pending_reason'] = 'same process naturally closed during capture; no credit'\n391:                     continue\n392:                 after_chain = util.ancestor_chain(after, worker, inventory, proc_root) or []\n393:                 same_chain = len(after_chain) == len(chain) and all(\n394:                     util.identity_equal(before, final) for before, final in zip(chain, after_chain))\n395:                 require(pair(after) == pair(identity)\n396:                         and maps_path.read_bytes() == maps_raw\n397:                         and (proc_root / str(identity['pid']) / 'cmdline').read_bytes() == raw_argv\n398:                         and (proc_root / str(identity['pid']) / 'exe').resolve(strict=True) == Path(executable['resolved'])\n399:                         and (proc_root / str(identity['pid']) / 'exe').stat().st_ino == executable['inode']\n400:                         and same_chain,\n401:                         'process/ancestry/maps changed during capture')\n402:                 result['processes'][robot] = {'identity': identity, 'identity_after': after,\n403:                     'argv': argv, 'actual_ancestry': chain, 'cmdline_sha256': sha(raw_argv),\n404:                     'maps_raw': maps_raw.decode(), 'maps_sha256': sha(maps_raw),\n405:                     'core_maps_lines': lines, 'executable': executable, 'core': core}\n406:             result['complete'] = (set(result['processes']) == set(ROBOTS)\n407:                                   and util.same(worker, proc_root) is not None\n408:                                   and (proc_root / str(worker['pid']) / 'cmdline').read_bytes() == actual_worker)\n409:             if not result['complete']:\n410:                 result.setdefault('pending_reason', 'awaiting three own active smoother processes')\n411:         except FileNotFoundError:\n412:             result['pending_reason'] = 'owned process naturally disappeared; no credit'\n413:         except (OSError, ValueError, KeyError, TypeError) as error:\n414:             result['errors'].append(str(error))\n415:             errors.append(str(error))\n416:     return {'schema': 'mr3-v25-smoother-live-mapping-v1', 'freeze': freeze,\n417:             'producer_source_sha256': sha(read(Path(__file__))),\n418:             'binding': {'path': str(binding_path), 'sha256': sha(read(Path(binding_path)))},\n419:             'monitor': {'path': str(monitor_path), 'sha256': sha(base_raw)},\n420:             'wall_monotonic_ns': time.monotonic_ns(), 'episodes': episodes, 'errors': errors,\n421:             'passed': not errors and any(row['complete'] for row in episodes),",
