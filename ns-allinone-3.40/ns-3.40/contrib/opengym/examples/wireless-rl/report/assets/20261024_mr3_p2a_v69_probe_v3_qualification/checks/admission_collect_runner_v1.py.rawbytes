"""Collect only the new canonical A69 entry IDs, then seal its fixed CPU spec."""
import hashlib
import importlib
import json
import os
from pathlib import Path
import subprocess
import time

ROOT=Path('/home/zhuyulab/ns3-workspace')
W=ROOT/'ns-allinone-3.40/ns-3.40/contrib/opengym/examples/wireless-rl'
MODULE='report.assets.20261024_mr3_p2a_v69_probe_v3_qualification.classification_admission_v1'
gate=importlib.import_module(MODULE)
assert Path.cwd()==W and Path(gate.__file__).resolve()==gate.A/'classification_admission_v1.py'
assert not gate.SPEC.exists(), 'preserve existing admission spec'
env=dict(os.environ,PYTHONNOUSERSITE='1',PYTHONDONTWRITEBYTECODE='1',CUDA_VISIBLE_DEVICES='')
env.pop('PYTHONPATH',None);env.pop('PYTHONHOME',None)
argv=[gate.PYTHON,'-B','-m','pytest','--collect-only','-q',*map(str,gate.TEST_FILES)]
started=time.monotonic_ns()
result=subprocess.run(argv,cwd=W,env=env,capture_output=True,text=True)
ended=time.monotonic_ns()
evidence=Path('/tmp/p2a69_admission_collect_v1.json')
with evidence.open('x') as f:
    json.dump(dict(actual_argv=argv,actual_waited=True,actual_returncode=result.returncode,
        started_monotonic_ns=started,ended_monotonic_ns=ended,
        stdout=result.stdout,stderr=result.stderr,collect_only=True,test_bodies_executed=False),f,indent=2)
    f.write('\n')
assert result.returncode==0, result.stderr
names=[]
for line in result.stdout.splitlines():
    if '::' in line and '.py::' in line:
        filepart=line.split('::',1)[0]
        if Path(filepart).name in {p.name for p in gate.TEST_FILES}:
            names.append(line.rsplit('::',1)[1])
assert len(names)==len(set(names))==gate.EXPECTED_CASE_COUNT==33
assert {name.split('[',1)[0] for name in names}==set(gate.REQUIRED_TESTS)
paths=[*(gate.A/name for name in gate.REQUIRED_NAMES),gate.OLD_EXTERNAL,*gate.TEST_FILES,*gate.CONFIG_FILES]
assert len(paths)==len(set(paths))==15
hashes={str(path.relative_to(ROOT)):hashlib.sha256(path.read_bytes()).hexdigest() for path in paths}
actual=[gate.PYTHON,'-B','-m','pytest','-q',*map(str,gate.TEST_FILES),'--junitxml',str(gate.JUNIT)]
value=dict(schema='mr3-v69-admission-cpu-spec-v1',actual_argv=actual,
    required_test_names=list(gate.REQUIRED_TESTS),expected_testcase_names=sorted(names),
    expected_source_hashes=hashes,pytest_junit=str(gate.JUNIT))
with gate.SPEC.open('x') as f:json.dump(value,f,indent=2);f.write('\n');f.flush();os.fsync(f.fileno())
print(json.dumps(dict(sealed=True,testcase_names=33,exact_current_source_hashes=len(hashes),
    spec=str(gate.SPEC),collect_evidence=str(evidence),test_bodies_executed=False)))
