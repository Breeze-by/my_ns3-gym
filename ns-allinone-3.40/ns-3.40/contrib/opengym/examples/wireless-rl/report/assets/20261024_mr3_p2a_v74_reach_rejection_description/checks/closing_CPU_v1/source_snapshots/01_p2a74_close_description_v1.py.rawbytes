#!/usr/bin/python3
"""V74 fixed metadata and opaque-byte closure; never reopens the original motion input."""
import argparse
from datetime import datetime,timezone
from decimal import Decimal
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import stat
import subprocess
import time
ROOT=Path('/home/zhuyulab/ns3-workspace')
W=ROOT/'ns-allinone-3.40/ns-3.40/contrib/opengym/examples/wireless-rl'
A=W/'report/assets/20261024_mr3_p2a_v74_reach_rejection_description'
G='fea46716eb0d4b9c5502812067caf869998da44d'
OLD_G='b3707dcf258c832f35ef60f47a5dc8dc52296629'
STATE=Path('/tmp/mr3_p2a_v74_parent_v1');TOOL=Path('/tmp/mr3_p2a_v74_root_tool_v1')
OUTPUT=Path('/tmp/mr3_p2a_v74_reach_rejection_description_v1.json')
FACTS=Path('/tmp/p2a74_description_closure_facts_v1.json')
ROOTS=(STATE,TOOL,OUTPUT)
PREVIOUS=A.parent/'20261024_mr3_p2a_v73_command_chain_description/closure_ledger_v1.json'
STAGE=Path('/tmp/p2a74_closed_copyready_v1')
DEST=STAGE/'closed_execution_v1';INVENTORY=STAGE/'closed_inventory_v1.json';LEDGER=STAGE/'closure_ledger_v1.json'
REVIEW=STAGE/'checks/closed_metadata_v1.json'
HELPER=W/'report/assets/20261022_mr3_p2a_v45_preparation_classification/collect_closed_v1.py'
CPU=Path('/tmp/p2a74_close_actual_wait_v1');CPU_REAP=Path('/tmp/p2a74_close_tool_wait_v1.json')
RESPONSES=Path('/tmp/p2a74_close_tool_actual_responses_v1.json')
PREVIOUS_G='45396954ed2612980859cff4629af1e6a662114c'

def need(ok,message):
    if not ok:raise ValueError(message)

def ref(path):
    raw=Path(path).read_bytes();return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())

def write(path,value):
    path.parent.mkdir(parents=True,exist_ok=True)
    with path.open('x') as stream:
        json.dump(value,stream,indent=2,ensure_ascii=False,allow_nan=False);stream.write('\n');stream.flush();os.fsync(stream.fileno())

def git(*args):return subprocess.check_output(['git',*args],cwd=ROOT,timeout=30)

def same(a,b):
    return all(type(a.get(k)) is int and a[k]>0 and a[k]==b.get(k) for k in ('pid','start_ticks'))

def setup():
    need(git('rev-parse','HEAD').decode().strip()==G==git('rev-parse','origin/main').decode().strip(),'original V74 HEAD/origin changed')
    need(ref(HELPER)['sha256']=='63d52ce389b7d61fa67f5080fa556b1f32e47b79e389800f9de55e97c40abf06','opaque copier changed')
    spec=importlib.util.spec_from_file_location('_v74_fixed_opaque_bytes',HELPER)
    m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m);m.A=STAGE;return m

def scan(m):
    files,dirs,links={},{},{}
    for root in ROOTS:
        mode=root.lstat().st_mode;paths=[root] if stat.S_ISREG(mode) else []
        need(stat.S_ISDIR(mode) or stat.S_ISREG(mode),'unexpected closed root kind')
        if stat.S_ISDIR(mode):
            for parent,names,nondirs in os.walk(root,followlinks=False):
                parent=Path(parent);dirs[str(parent)]=m.stamp(parent.lstat());names.sort();nondirs.sort()
                for name in list(names):
                    p=parent/name
                    if p.is_symlink():
                        links[str(p)]=dict(lstat=m.stamp(p.lstat()),literal_target=os.readlink(p),target_followed=False);names.remove(name)
                    else:need(stat.S_ISDIR(p.lstat().st_mode),'special original directory entry')
                for name in nondirs:
                    p=parent/name
                    if p.is_symlink():links[str(p)]=dict(lstat=m.stamp(p.lstat()),literal_target=os.readlink(p),target_followed=False)
                    else:paths.append(p)
        for p in paths:
            need(str(p) not in files,'overlapping roots');files[str(p)]=m.regular_stamp(p)
    return dict(files=files,directories=dirs,links=links)

def close(m):
    need(not git('status','--porcelain','--untracked-files=all'),'metadata closure requires original clean source freeze')
    summary,sref=m.metadata(STATE/'summary.json');boot,bref=m.metadata(STATE/'bootstrap.json')
    actual,aref=m.metadata(TOOL/'actual_reap_v1.json');post,postref=m.metadata(TOOL/'actual_postreap_source_and_gone_v1.json')
    result,oref=m.metadata(OUTPUT);previous,pref=m.metadata(PREVIOUS);facts,fref=m.metadata(FACTS)
    need(actual['schema']=='mr3-v74-actual-root-tool-reap-v1'
         and type(actual['actual_tool_session_id']) is int and actual['actual_tool_session_id']==35799
         and type(actual['actual_tool_returncode']) is int and actual['actual_tool_returncode']==0
         and actual['actual_tool_objects']['initial']['session_id']==35799
         and type(actual['actual_tool_objects']['final']['exit_code']) is int and actual['actual_tool_objects']['final']['exit_code']==0
         and type(actual['observed_monotonic_ns']) is int,'real Root35799 initial/final reap0 differs')
    need(post['schema']=='mr3-v74-post-root-reap-source-and-gone-v1' and post['passed'] is True
         and post['execution_freeze']==G and post['source_count']==27
         and post['source_before_after_current_Git_and_recovery_equal'] is True
         and post['output']==oref,'Root post-source/recovery/output scope differs')
    need(summary['schema']=='mr3-v74-fixed-description-parent-result-v1' and summary['passed'] is True
         and summary['execution_freeze']==G and summary['errors']==[] and summary['complete_parent_fee_known'] is True
         and summary['engineering_entry_verified'] is True and summary['all_submitted_consumer_waited'] is True
         and summary['native_runs']==summary['model_runs']==0 and summary['scientific_qualification'] is False
         and summary['capacity_qualified'] is False and summary['automatic_policy_entry_allowed'] is False
         and summary['P2A_complete'] is False,'actual limited description PASS scope differs')
    consumer=summary['consumer'];owners={'driver':summary['driver_identity'],'consumer':consumer['child_identity']}
    need((owners['driver']['pid'],owners['driver']['start_ticks'])==(2252687,456193157)
         and (owners['consumer']['pid'],owners['consumer']['start_ticks'])==(2252768,456193397)
         and same(owners['driver'],boot['bootstrap_identity']) and same(owners['consumer'],result['identity'])
         and boot['execution_freeze']==G and len(post['saved_identities'])==2,'typed original saved identity scope differs')
    observations=[]
    for role,saved in owners.items():
        rows=[r for r in post['saved_identities'] if r['role']==role and r['saved']==saved]
        need(len(rows)==1 and rows[0]['freshgone'] is True,'Root original freshgone receipt differs')
        m.require_absent(saved);observations.append(dict(role=role,saved=saved,freshgone=True,observed_monotonic_ns=time.monotonic_ns()))
    before=summary['source_before'];need(before==summary['source_after'] and len(before)==27
         and len({r['path'] for r in before})==27,'actual27 before/after differs')
    recovery,_=m.metadata(STATE/'source_recovery_v1.json');need(len(recovery)==27,'actual27 recovery records missing')
    recovered={r['original']:r for r in recovery};need(len(recovered)==27,'duplicate snapshot original');source_meta=[]
    manifest,_=m.metadata(A/'source_blob_manifest_v1.json')
    need(set(manifest['source_bindings'])=={str(Path(r['path']).relative_to(ROOT)) for r in before}
         and manifest['original_payload_excluded'] is True,'runtime manifest/source scope mismatch')
    for row in before:
        p=Path(row['path']);need(p.is_relative_to(ROOT) and p.resolve(strict=True)==p,'noncanonical source path')
        need(m.regular_stamp(p)==row['stat'] and ref(p)=={k:row[k] for k in ('path','bytes','sha256')},'actual source bytes/stat changed')
        need(manifest['source_bindings'][str(p.relative_to(ROOT))]==row['sha256']
             and hashlib.sha256(git('show',G+':'+str(p.relative_to(ROOT)))).hexdigest()==row['sha256'],'current source differs from original execution Git')
        r=recovered[str(p)];snapshot=Path(r['snapshot']);need(snapshot.is_relative_to(STATE/'source_snapshots')
             and snapshot.resolve(strict=True)==snapshot and (r['bytes'],r['sha256'])==(row['bytes'],row['sha256'])
             and ref(snapshot)==dict(path=str(snapshot),bytes=row['bytes'],sha256=row['sha256']),'actual source snapshot restore differs')
        source_meta.append(dict(**row,current_Git_equal=True,source_recovery=dict(r)))
    spec,_=m.metadata(A/'description_spec_v1.json')
    need(consumer['actual_waited'] is True and type(consumer['actual_returncode']) is int and consumer['actual_returncode']==0
         and consumer['wait_errors']==[] and consumer['spawn_error'] is None
         and result['schema']=='mr3-v74-fixed-reach-rejection-description-v1' and result['passed'] is True
         and result['description_status']=='COMPLETE' and result['execution_freeze']==G and result['original_evidence_freeze']==OLD_G
         and result['spec_sha256']==ref(A/'description_spec_v1.json')['sha256']
         and result['raw_input_bytes_read']==summary['raw_input_bytes_read']==507221955
         and result['raw_input_bytes_read_known'] is True and result['parse_errors']==0 and result['semantic_error_count']==0
         and result['record_sequence_gap_count']==0 and result['parsed_jsonl_rows']==result['observed_jsonl_lines']==232887
         and result['complete_input_read'] is True and result['complete_newline_tail'] is True
         and result['input_SHA_matches_pin'] is True and result['input_size_matches_pin'] is True
         and result['input_proofs']==[dict(path=r['path'],bytes=r['expected_bytes'],sha256=r['expected_sha256']) for r in spec['inputs']]
         and result['original_FAIL_preserved'] is True and result['original_activity_passed']==dict(present=True,value=False)
         and type(result['original_activity_passed']['present']) is bool and type(result['original_activity_passed']['value']) is bool
         and result['native_or_physics_or_qualification_credit'] is False
         and result['mathematical_pair_checks_replayed'] is False and result['old_FAIL_rejudged'] is False
         and result['candidate_records']==result['tb3_window_decisions']==250 and len(result['rejection_samples'])==4
         and result['actual_wheel_SetParam_or_readback_checked'] is False and result['physical_stop_or_continuous_bounds_replayed'] is False
         and result['previous_description_passed'] is True and result['previous_description_execution_freeze']==PREVIOUS_G
         and Decimal(str(result['actual_work_seconds']))==Decimal('41.065690642')<=240
         and oref['bytes']==894600 and oref['sha256']=='647f298934fe1a44b1ad666d5d532abac3deeb88337cb17dff75529bdf7d35b6'
         and summary['consumer_output']==oref,'actual waited derived description header differs')
    need(summary['consumer_description']['original_activity_passed']==dict(present=True,value=False)
         and facts['schema']=='mr3-v74-description-closing-facts-v1' and facts['description_path']==str(OUTPUT)
         and facts['description_bytes']==oref['bytes'] and facts['description_sha256']==oref['sha256']
         and facts['original_motion_reopened_for_closure'] is False,'closing facts provenance differs')
    begin,end=summary['complete_parent_started_monotonic_ns'],summary['ended_monotonic_ns']
    need(type(begin) is int and type(end) is int and begin==boot['complete_parent_started_monotonic_ns']
         and begin<consumer['call_started_monotonic_ns']<consumer['ended_monotonic_ns']<=end<=actual['observed_monotonic_ns']
         and Decimal(consumer['ended_monotonic_ns']-consumer['call_started_monotonic_ns'])/10**9==Decimal(consumer['actual_wait_seconds']),
         'real continuous wait nesting differs')
    fee=Decimal(end-begin)/10**9;entry=Decimal(previous['engineering_cumulative_seconds']);ceiling=Decimal(previous['engineering_ceiling_seconds'])
    need(pref['bytes']==6066 and pref['sha256']=='4211c4b4ed13d26db405b93797fc1ea3a937b705f420f49db8cce2762f34d271'
         and previous['passed'] is True and previous['activity_passed'] is True and previous['description_passed'] is True
         and previous['execution_freeze']==PREVIOUS_G and previous['original_activity_passed']==dict(present=True,value=False)
         and entry==Decimal('112639.6725192646018') and ceiling==180000
         and fee==Decimal('45.633274384')==Decimal(summary['actual_parent_seconds'])==Decimal(summary['engineering_added_parent_union_seconds'])
         and entry==Decimal(summary['engineering_entry_seconds']) and ceiling==Decimal(summary['engineering_ceiling_seconds'])
         and entry+fee==Decimal('112685.3057936486018')==Decimal(summary['engineering_cumulative_seconds'])
         and ceiling-entry-fee==Decimal('67314.6942063513982')==Decimal(summary['engineering_remaining_seconds'])
         and Decimal(summary['complete_parent_cap_seconds'])==300 and fee<=300
         and summary['pilot_added_parent_union_seconds']==summary['validation_added_parent_union_seconds']=='0','continuous carried fee differs')
    for p in (DEST,INVENTORY,LEDGER,REVIEW):need(not p.exists(),'existing closure attempt must be preserved')
    frozen=scan(m)
    review=dict(schema='mr3-v74-description-metadata-close-v1',passed=True,activity_passed=True,
        activity_scope='fixed single motion Reach-rejection field description only',execution_freeze=G,root_actual_reap_and_gone=aref,
        original_summary=sref,bootstrap=bref,original_derived_output=oref,closing_facts=fref,
        actual_source_before_after_equal=True,current_Git_source_count=len(before),actual_source_meta=source_meta,all_source_snapshots_restored=True,
        saved_main_identity_count=2,saved_main_observations=observations,nonowned_ancestor_absence_claimed=False,
        engineering_added_parent_union_seconds=str(fee),consumer_work_seconds=str(result['actual_work_seconds']),
        complete_original_input_bytes_reported=507221955,original_motion_reopened_for_closure=False,old_342_libraries_reread=False,
        original_activity_passed=dict(present=True,value=False),original_FAIL_preserved=True,
        parsed_rows=232887,parse_errors=0,semantic_errors=0,record_sequence_gaps=0,
        mathematical_pair_checks_replayed=False,candidate_records=250,selected_whole_line_payloads=4,
        root_cause='UNKNOWN_PENDING_SEPARATE_DERIVED_ROUTE_REVIEW',scientific_native_physics_qualification_credit=False)
    write(REVIEW,review);entries=[]
    try:
        for path,stamp in sorted(frozen['files'].items()):
            p=Path(path);target=Path(str(DEST/'tmp'/p.relative_to('/tmp'))+'.rawbytes.gz')
            entries.append(m.archive(p,dict(target=target,compressed=True,stat=stamp)))
        need(scan(m)==frozen,'closed originals membership/stat changed during opaque archive')
        for row in before:
            p=Path(row['path']);need(m.regular_stamp(p)==row['stat'] and ref(p)=={k:row[k] for k in ('path','bytes','sha256')},'source changed during closure')
        need(git('rev-parse','HEAD').decode().strip()==G==git('rev-parse','origin/main').decode().strip()
             and not git('status','--porcelain','--untracked-files=all'),'original source freeze changed during closure')
        for saved in owners.values():m.require_absent(saved)
    except BaseException as error:
        write(STAGE/'closed_inventory_v1.failed.json',dict(passed=False,error=repr(error),entries=entries,
            originals_deleted=False,completed_and_partial_wrappers_retained=True));raise
    inventory=dict(schema='mr3-v74-fixed-description-opaque-inventory-v1',passed=True,activity_passed=True,execution_freeze=G,
        original_roots=list(map(str,ROOTS)),entries=entries,regular_count=len(entries),
        original_bytes=sum(r['original_bytes'] for r in entries),canonical_bytes=sum(r['canonical_bytes'] for r in entries),
        links=frozen['links'],symlink_count=len(frozen['links']),symlink_targets_followed=False,
        all_original_bytes_losslessly_verified=True,originals_deleted=False,original_motion_reopened=False,
        old_342_libraries_reread=False,scientific_results_recomputed=False)
    need(all(r['canonical_bytes']<=64*1024*1024 for r in entries),'archive exceeds64MiB; preserve original attempt')
    write(INVENTORY,inventory);saved={r['original']:r for r in entries}
    def packed(path):
        row=saved[str(path)];return dict(original={k:row[k] for k in ('original','original_bytes','original_sha256')},
            canonical=ref(STAGE/row['canonical']),codec=row['codec'])
    ledger=dict(schema='mr3-engineering-closure-ledger-v1',recorded_utc=datetime.now(timezone.utc).isoformat(),
        execution_freeze=G,passed=True,activity_passed=True,
        activity_passed_scope='fixed one-motion Reach-rejection field description PASS; no mathematical replay or new physics/qualification/learning',
        actual_root_tool_session_id=35799,actual_root_tool_returncode=0,previous_actual_ledger=pref,
        engineering_entry_seconds=str(entry),engineering_added_parent_union_seconds=str(fee),engineering_cumulative_seconds=str(entry+fee),
        engineering_ceiling_seconds=str(ceiling),engineering_remaining_seconds=str(ceiling-entry-fee),
        accounting_basis=summary['fee_scope'],nested_receipts_double_added=False,root_tool_interval_invented=False,numeric_user_approval_claimed=False,
        engineering_ceiling_decision_maker='agent',continuous_user_delegation_preserved=True,
        pilot_added_parent_union_seconds='0',validation_added_parent_union_seconds='0',
        **{k:previous[k] for k in ('pilot_remaining_decisions','pilot_remaining_seconds','validation_original_decisions','validation_original_seconds','validation_original_final_only_cases')},
        original_pilot_final_totals_preserved=True,actual_before_after_equal=True,actual_returned_source_before_count=len(before),actual_returned_source_after_count=len(before),
        current_source_Git_full_scope_pass_claimed=True,current_Git_source_count=len(before),all_source_snapshots_restored=True,
        saved_main_identity_count=2,all_saved_main_identities_fresh_gone=True,nonowned_ancestor_absence_claimed=False,
        consumer_actual_waited=True,consumer_actual_returncode=0,consumer_work_seconds=str(result['actual_work_seconds']),
        complete_input_bytes_read=507221955,original_input_count=1,original_V71_inputs_not_reconsumed_for_closure=True,
        description_passed=True,description_status='COMPLETE',mathematical_pair_checks_replayed=False,candidate_records=250,selected_whole_line_payloads=4,parsed_jsonl_rows=232887,parse_errors=0,semantic_errors=0,record_sequence_gaps=0,
        original_activity_execution_freeze=OLD_G,previous_description_execution_freeze=PREVIOUS_G,
        original_activity_passed=dict(present=True,value=False),old_FAIL_rejudged=False,
        root_cause='UNKNOWN_PENDING_SEPARATE_DERIVED_ROUTE_REVIEW',native_runs=0,optimizer_updates=0,
        scientific_qualification_credit=False,capacity_qualified=False,automatic_pilot_final_entry_allowed=False,P2A_complete=False,
        driver_summary=packed(STATE/'summary.json'),actual_root_tool_reap_and_gone=packed(TOOL/'actual_reap_v1.json'),
        derived_description=packed(OUTPUT),closed_inventory=ref(INVENTORY),metadata_review=ref(REVIEW),Root_postreap_source_and_gone=packed(TOOL/'actual_postreap_source_and_gone_v1.json'),
        canonical_output_written=False,canonical_installation_owner='Root',subsequent_closure_CPU_engineering_added_seconds='0')
    write(LEDGER,ledger)
    print(json.dumps(dict(passed=True,description_passed=True,ledger=ref(LEDGER),regular_count=len(entries),
        original_bytes=inventory['original_bytes'],canonical_bytes=inventory['canonical_bytes'],symlink_count=inventory['symlink_count'])),flush=True)

if __name__=='__main__':
    close(setup())
