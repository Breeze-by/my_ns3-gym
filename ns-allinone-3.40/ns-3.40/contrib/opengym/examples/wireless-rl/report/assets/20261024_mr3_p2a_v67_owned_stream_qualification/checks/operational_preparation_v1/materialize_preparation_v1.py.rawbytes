"""Five preparation documents from closed V67 receipts; no source sweep/test.

Run only after collect/admission/prepare/plancheck really finish. This does not
claim future INDEX/HEAD blob checks or its own later actual tool reap.
"""
from datetime import datetime,timezone
from decimal import Decimal
import hashlib
import json
import os
from pathlib import Path
import time

ROOT=Path('/home/zhuyulab/ns3-workspace')
W=ROOT/'ns-allinone-3.40/ns-3.40/contrib/opengym/examples/wireless-rl'
A=W/'report/assets/20261024_mr3_p2a_v67_owned_stream_qualification'
PREVIOUS=A.parent/'20261024_mr3_p2a_v66_owned_stream_qualification/closure_ledger_v1.json'
BUILD=A.parent/'20261024_mr3_p2a_v66_owned_stream_qualification/checks/native_build_v1/build_manifest_v1.json'


def need(ok,message):
    if not ok:raise ValueError(message)


def read(path):return json.loads(Path(path).read_text())


def ref(path):
    raw=Path(path).read_bytes();return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())


def write(path,value):
    with path.open('x') as f:json.dump(value,f,indent=2,ensure_ascii=False,allow_nan=False);f.write('\n');f.flush();os.fsync(f.fileno())


def freshgone(saved):
    need(type(saved.get('pid')) is int and saved['pid']>0 and type(saved.get('start_ticks')) is int and saved['start_ticks']>0,
         'missing actual saved PID/start')
    path=Path('/proc')/str(saved['pid'])/'stat'
    try:raw=path.read_text()
    except FileNotFoundError:return
    need(int(raw.rsplit(')',1)[1].split()[19])!=saved['start_ticks'],'saved actual CPU identity remains including zombie')


def phase(name,directory):
    wait=read(directory/'actual_wait.json');root=read(directory/'root_reap_v1.json')
    need(wait['scope']=='cpu' and wait['passed'] is True and wait['actual_waited'] is True
         and type(wait['actual_returncode']) is int and wait['actual_returncode']==0
         and wait['source_unchanged'] is True and wait['source_before']==wait['source_after'] and not wait['errors'],
         'actual closed preparation wait failed: '+name)
    need(root['actual_waited'] is True and type(root['actual_returncode_observed']) is int
         and root['actual_returncode_observed']==0 and type(root['actual_tool_session_id']) is int
         and root['observed_monotonic_ns']>=wait['ended_monotonic_ns'],'actual Root tool reap0 missing: '+name)
    need(Decimal(wait['actual_child_wait_seconds'])==Decimal(wait['ended_monotonic_ns']-wait['started_monotonic_ns'])/10**9,
         'actual preparation duration differs')
    for key in ('coordinator_identity','child_identity'):freshgone(wait[key])
    return dict(name=name,actual_tool_session_id=root['actual_tool_session_id'],actual_wait=ref(directory/'actual_wait.json'),
        root_actual_reap=ref(directory/'root_reap_v1.json'),actual_child_wait_seconds=wait['actual_child_wait_seconds'],
        source_count=len(wait['source_before']),source_before_after_equal=True,both_saved_CPU_identities_freshgone=True)


facts=[phase('collect',Path('/tmp/p2a67_collect_actual_wait_v2')),
       phase('admission',A/'checks/admission_cpu_v1'),phase('prepare',A/'checks/prepare_cpu_v1'),
       phase('plancheck',A/'checks/plan_check_cpu_v1')]
expected={'collect':(87228,'1.287563027',4),'admission':(91834,'9.117805801',311),
          'prepare':(37303,'14.315266716',330),'plancheck':(40409,'0.446538907',1122)}
for row in facts:
    sid,seconds,count=expected[row['name']]
    need(row['actual_tool_session_id']==sid and Decimal(row['actual_child_wait_seconds'])==Decimal(seconds)
         and row['source_count']==count,'actual finalized preparation facts differ')
first_dir=Path('/tmp/p2a67_collect_actual_wait_v1')
first=read(first_dir/'actual_wait.json');first_reap=read(first_dir/'root_reap_v1.json')
need(first['actual_waited'] is True and first['actual_returncode']==1 and first['passed'] is False
     and first['source_before']==first['source_after'] and len(first['source_before'])==4
     and first_reap['actual_tool_session_id']==96426 and first_reap['actual_waited'] is True
     and first_reap['actual_returncode_observed']==1,'original collect v1 actual failure was not preserved')
for key in ('coordinator_identity','child_identity'):freshgone(first[key])
need(not Path('/tmp/mr3_p2a_reach_v67_driver_v1').exists(),'formal parent already exists; no prep document writes allowed')
previous=read(PREVIOUS);previous_ref=ref(PREVIOUS)
need(previous_ref['bytes']==5261 and previous_ref['sha256']=='6e2832b06b6f8330b7eecb3c7027e29c8580b40c52b20f92f449adcb6a9ebe75'
     and previous['passed'] is True and previous['activity_passed'] is False
     and previous['actual_root_tool_session_id']==16973 and previous['actual_root_tool_returncode']==1
     and previous['original_source_scope_status']=='UNKNOWN_INITIAL_SOURCE_CHECK_ABORTED'
     and previous['actual_before_after_equal'] is None
     and previous['engineering_added_parent_union_seconds']=='13.521178149','actual V66 FAIL/UNKNOWN account differs')
resource=read(A/'resource_v1.json');scope=read(A/'scope_v1.json');plan=read(A/'plan_v1.json');check=read(A/'checks/plan_check_v1.json')
need(resource['engineering_used_seconds']==previous['engineering_cumulative_seconds']=='109144.8478173156018'
     and resource['engineering_ceiling_seconds']=='180000' and resource['engineering_remaining_seconds']=='70855.1521826843982'
     and resource['total_reservation_seconds']=='47220' and resource['numeric_user_approval_claimed'] is False
     and scope['admitted'] is True and scope['capacity_qualified'] is False and scope['automatic_policy_entry_allowed'] is False,
     'fixed prospective software authorization/account differs')
need(check['passed'] is True and check['plan_sha256']==ref(A/'plan_v1.json')['sha256']
     and check['episodes']==12 and check['mandatory_roles']==30 and check['world_started'] is False
     and plan['prospective_classification_regression']['fixture_case_count']==33,'actual plancheck/new33 workload differs')
need(ref(A/'plan_v1.json')['sha256']=='feb5330fbacfa6925a7b57674204ab7e356e1e3fbb2a614086dd6236ccf041d0'
     and ref(A/'native_custody_binding_v1.json')['sha256']=='453eab3200aeaf739c8c470387e309b9a3c015e95435e5caab36d2674ca66b97'
     and len(plan['source_bindings'])==1110 and len(plan['library_bindings'])==10,'actual final plan/binding differs')
index_path=A/'checks/plan_git_blob_guard_v1/index_positive_v1.json'
index=read(index_path)
need(index['schema']=='mr3-plan-current-git-blob-precommit-check-v1' and index['passed'] is True
     and index['revision']=='INDEX' and index['plan_sha256']==ref(A/'plan_v1.json')['sha256']
     and index['expected_path_count']==index['checked_regular_git_blob_count']==1111
     and index['plan_source_binding_count']==1110 and index['errors']==[]
     and index['scientific_credit'] is False,'actual INDEX blob-positive proof differs')
preserved=plan['prospective_preparation_requirement']
need(preserved['passed'] is True and preserved.get('new_A67_688_tests_executed') is False
     and preserved['credit_requires_exact_current_source_bytes'] is True
     and preserved['readiness_device_observation_is_historical'] is True
     and preserved['formal_preflight_checks_current_cuda_and_source_build_again'] is True,
     'old A65 software evidence was relabelled as new runtime evidence')
build=read(BUILD)
need(ref(BUILD)['sha256']=='4b7ba3610ad549a9dc25e591fcb0ad00f334b7a55a276570ad9937fe4eaf8eeb'
     and build['same_ELF_bytes_as_A59'] is True and build['compiler_or_link_jobs_claimed'] is False,
     'inherited actual A66 build was changed/overstated')
for path in (A/'preparation_outcome_v1.json',W/'report/20261024_mr3_p2a_v67_owned_stream_qualification.md'):
    need(not path.exists(),'preparation outcome/report already exists')

def stamp(row):return f"tool{row['actual_tool_session_id']}真实reap0/{row['actual_child_wait_seconds']}秒/{row['source_count']}绑定"
by_name={row['name']:row for row in facts}
paragraph=('2026-10-24 V67准备完成，尚未native：承接V66真实source门FAIL与13.521178149秒；原before/after=[]、完整来源UNKNOWN，'
    '不能以新提交补成旧0源PASS。旧8a7e冻结与失败保持。A66 current21实际增量build及原ELF/七宏按原路径继承，V67无新build/编译job信用；'
    'A65原212ROS+476learner/readiness仅按当前逐源相等复用软件证明，未新跑688。'
    '新33入口'+stamp(by_name['admission'])+'；prepare '+stamp(by_name['prepare'])+'；plancheck '+stamp(by_name['plancheck'])+'。'
    f"新计划{len(plan['source_bindings'])}源/{len(plan['library_bindings'])}ELF、12EP/30角色及双profile保持。"
    '工程新增0，仍109144.8478173156018/C180000、余70855.1521826843982，预约47220；代理持续委托选择上限，非数值用户批准，pilot/final原额保持。'
    'admitted仅前瞻软件授权，capacity/autoPolicy=False，P2A未完成。')
report=W/'report/20261024_mr3_p2a_v67_owned_stream_qualification.md'
report.write_text('# MR3 P2A V67：完整Git证据入树与矩阵资格准备\n\n'+paragraph+'\n\n'
    '实际collect-only '+stamp(by_name['collect'])+'，只收集新33 ID，不代替执行33。四个准备工具的真实回执与保存CPU身份均已关闭；本段不重读约1100个来源文件，不运行科学reader或World。\n\n'
    '首轮collect工具96426真实rc1/1.267244291秒、4源稳定：外部helper遗留旧/tmp/p2a66_admission_collect_v1.json的独占输出路径，旧文件未覆写，测试body/World均0。'
    '其actualwait/console/原helper/rootreap已逐字保在checks/collection_setup_failure_v1；第二版只修正为新的p2a67输出路径，原失败不改判。\n\n'
    '入场次序固定为：force-stage所有被plan引用的selected regular证据→实际INDEX逐blob/SHA正检查并将回执入checks→commit/push/clean→在/tmp RootTool中执行实际exact HEAD逐blob/SHA正检查→唯一bootstrap。'
    'INDEX工具42568已真实rc0，1111个regular Git blob/current SHA全匹配、errors=[]；回执在checks/plan_git_blob_guard_v1/index_positive_v1.json，只有软件来源信用。'
    '此处未声称未来HEAD检查PASS；精确HEAD检查必须在commit/push后于/tmp写回执以保持canonical worktree clean。'
    '原scope配置在新33前已授权并封存，不能测试后再flip。正式preflight仍核新freeze/current21 build桥和当前CUDA；资格矩阵不自动调用minimum/PPO/pilot/final。\n\n'
    '[准备结果](assets/'+A.name+'/preparation_outcome_v1.json) · [V66规范失败末账](assets/20261024_mr3_p2a_v66_owned_stream_qualification/closure_ledger_v1.json)\n')
for path,link in ((ROOT/'AGENTS.md',str(report.relative_to(ROOT))),
                  (W/'AGENTS.md','report/'+report.name),(W/'report/README.md',report.name)):
    title,body=path.read_text().split('\n\n',1);path.write_text(title+'\n\n'+paragraph+' 见[V67准备]('+link+')；下方保留历史快照。\n\n'+body)
log=W/'log.md';log.write_text(log.read_text().rstrip()+'\n\n## 2026-10-24 V67完整Git证据入树准备\n\n'+paragraph+'\n')
write(A/'preparation_outcome_v1.json',dict(schema='mr3-v67-software-preparation-outcome-v1',passed=True,
    recorded_utc=datetime.now(timezone.utc).isoformat(),actual_preparation_waits=facts,
    original_collect_failure=ref(first_dir/'actual_wait.json'),original_collect_failure_root_reap=ref(first_dir/'root_reap_v1.json'),
    original_collect_failure_canonical_directory=str(A/'checks/collection_setup_failure_v1'),
    previous_actual_ledger=previous_ref,previous_source_scope_remains='UNKNOWN_INITIAL_SOURCE_CHECK_ABORTED',
    inherited_A66_current21_build=ref(BUILD),new_V67_build_executed=False,new_compiler_jobs_claimed=False,
    preserved_A65_evidence_asset=preserved['preserved_evidence_asset'],new_688_tests_executed=False,new_entry_cases=33,
    plan=ref(A/'plan_v1.json'),binding=ref(A/'native_custody_binding_v1.json'),source_count=len(plan['source_bindings']),ELF_count=len(plan['library_bindings']),
    engineering_added_seconds='0',engineering_cumulative_seconds='109144.8478173156018',engineering_ceiling_seconds='180000',
    engineering_remaining_seconds='70855.1521826843982',engineering_reservation_seconds='47220',numeric_user_approval_claimed=False,
    actual_INDEX_positive=ref(index_path),actual_INDEX_tool_session_id=42568,actual_INDEX_tool_returncode=0,
    actual_exact_HEAD_positive_not_claimed_here=True,
    force_stage_all_selected_regular_and_INDEX_positive_required_before_commit=True,
    exact_HEAD_positive_in_tmp_and_clean_required_before_formal=True,
    native_started=False,World_started=False,optimizer_updates=0,capacity_qualified=False,
    automatic_policy_entry_allowed=False,P2A_complete=False,own_materializer_later_true_reap_required_externally=True))
print(json.dumps(dict(passed=True,docs_updated=5,preparation_outcome=ref(A/'preparation_outcome_v1.json'),native_started=False)))
